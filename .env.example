# Environment variables for the new Supabase project.
# Copy this file to .env and fill in the values from your new Supabase project dashboard.
# Never commit the real .env file with actual credentials.

# ------------------------------------------------------------------
# Supabase — New Project
# ------------------------------------------------------------------

# Your new Supabase project URL (e.g. https://xxxxxxxxxxxxxxxxxxxx.supabase.co)
SUPABASE_URL=
VITE_SUPABASE_URL=

# Your new Supabase "anon/public" key (safe to expose to the browser)
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Your new Supabase project reference ID (the part of the URL before .supabase.co)
SUPABASE_PROJECT_ID=
VITE_SUPABASE_PROJECT_ID=

# ------------------------------------------------------------------
# Server-side only (never expose to the browser)
# ------------------------------------------------------------------

# Your new Supabase "service_role" key — used for admin operations (bypasses RLS)
# Find this in: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# Optional — Cron job authentication
# ------------------------------------------------------------------
# A secret string used to authenticate scheduled server function calls.
# Generate with: openssl rand -base64 32
CRON_SECRET=
CRON_SECRET_PREVIOUS=
